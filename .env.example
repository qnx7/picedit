# AI Image Editing API key (OpenAI DALL-E 2 edit endpoint)
# Get your key at: https://platform.openai.com/api-keys

# For the STATIC build (GitHub Pages / `npm run build`), editing runs in the
# browser and reads this public, build-time key. Note: a NEXT_PUBLIC_ key is
# visible to anyone using the site, so only use a restricted/spending-capped key.
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Without any key the app still runs fully and shows a friendly
# "AI editing not configured" notice instead of crashing.
